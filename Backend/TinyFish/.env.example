# Industrial Safety Compliance Auditor
# Autonomous Industrial Safety and Compliance Intelligence Platform

# ── TINYFISH OFFICIAL SEARCH & FETCH CREDENTIALS ────────────
# Get your free key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
TINYFISH_ENABLED=true
TINYFISH_SEARCH_ENDPOINT=https://api.search.tinyfish.ai
TINYFISH_FETCH_ENDPOINT=https://api.fetch.tinyfish.ai
TINYFISH_TIMEOUT=12

# ── GEMINI LLM GROUNDING (Optional Fallback Supported) ─────
GEMINI_API_KEY=

# ── SERVER & NETWORK GOVERNANCE ─────────────────────────────
PORT=5000
FLASK_ENV=development
CORS_ORIGIN=*
